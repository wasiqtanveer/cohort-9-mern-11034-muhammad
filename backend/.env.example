# these are the environment variables for the backend server
# make sure you have a .env file in the backend folder with the following variables
PORT=5000
NODE_ENV=development
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=notes_app

#dummy db for test
DB_NAME_TEST=notes_app_test


JWT_SECRET=
JWT_EXPIRES_IN=7d

#related to logger.js to detrmine what type of the logs to be printed in the console.
LOG_LEVEL=debug
